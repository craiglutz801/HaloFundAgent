{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.example/contracts/decision.schema.json",
  "title": "IcDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_sha256", "decision", "rationale", "expected_case_version", "policy_version"],
  "properties": {
    "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "enum": ["approve", "pass", "defer", "terms_revision"] },
    "rationale": { "type": "string", "minLength": 8 },
    "expected_case_version": { "type": "integer" },
    "policy_version": { "type": "string" }
  }
}
