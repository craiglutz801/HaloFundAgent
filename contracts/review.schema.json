{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.example/contracts/review.schema.json",
  "title": "Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_sha256", "verdict", "notes"],
  "properties": {
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verdict": { "enum": ["approve_draft", "request_changes", "reject_unsupported"] },
    "notes": { "type": "string", "minLength": 1 }
  }
}
