# Fixture mode runs with no commercial credentials.
# Copy to .env for local development. Leave secrets empty until a provider is provisioned.
# `make bootstrap` writes a local .env when this file has not been copied yet.

HALO_MODE=fixture
HALO_BIND_HOST=127.0.0.1
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
OBJECT_STORE=local
OBJECT_BUCKET=
OBJECT_ROOT=
MODEL_PROVIDER=fake
MODEL_ID_FAST=
MODEL_ID_ANALYSIS=
MODEL_ID_CRITIC=
MODEL_PROVIDER_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
SESSION_COOKIE_SECURE=false
